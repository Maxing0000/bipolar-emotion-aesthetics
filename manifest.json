{
  "name": "bipolar-emotion-aesthetics",
  "display_name": "双极情绪美学 BEA",
  "version": "2.8.0",
  "description": "双极情绪美学（Bipolar Emotion Aesthetics，BEA）v2.8.0——把审美判断从'我觉得'变成可讨论、可比较、可改进的协作工具。用 W(T) 危极权重 + 六范式定位 + 四维评分卡，把'这个设计好不好看'变成可计算的元素级改进方案。支持图片分析、病症诊断、设计优化、美感生成与轻量级快速诊断，覆盖产品/汽车/建筑/品牌/UI/时尚九大领域。在豆包、WorkBuddy、SkillHub、扣子、ChatGPT、Claude、通义千问、Dify 等平台可用，纯 Python 标准库离线运行。",
  "author": {
    "name": "马星",
    "username": "xkbk0000"
  },
  "license": "CC BY-NC-SA 4.0",
  "keywords": [
    "美学", "设计", "审美", "形式美", "双极情绪", "BEA",
    "产品设计", "汽车设计", "建筑设计", "UI设计", "品牌设计",
    "美感分析", "设计评审", "设计优化", "美感生成",
    "aesthetics", "design", "beauty", "formal beauty",
    "bipolar emotion", "product design", "car design",
    "architecture", "UI design", "brand design"
  ],
  "categories": ["设计", "创意", "分析", "教育"],
  "entry": "SKILL.md",
  "runtime": {
    "type": "markdown+python",
    "python_version": ">=3.7",
    "dependencies": [],
    "offline_capable": true,
    "network_required": false
  },
  "capabilities": [
    {
      "id": "analyze",
      "name": "美感分析",
      "description": "分析任何形式对象的美感，输出W(T)、范式、主辅比、四维评分",
      "input": ["自然语言描述", "图片", "维度值"],
      "output": ["分析报告", "JSON数据"]
    },
    {
      "id": "diagnose",
      "name": "病症诊断",
      "description": "诊断7种审美病症（甜腻/攻击/均分/重点通胀等），给出元素级处方",
      "input": ["分析对象"],
      "output": ["病症列表", "改进处方"]
    },
    {
      "id": "optimize",
      "name": "设计优化",
      "description": "给定目标范式，输出具体维度调整方案，含调整后验证",
      "input": ["当前配置", "目标范式/W(T)"],
      "output": ["调整方案", "验证结果"]
    },
    {
      "id": "generate",
      "name": "美感生成",
      "description": "给定目标范式/W(T)，自动生成最优维度配置",
      "input": ["目标范式/W(T)", "品类", "策略"],
      "output": ["维度配置", "范式说明"]
    },
    {
      "id": "compare",
      "name": "方案对比",
      "description": "对比两个或多个设计方案的W(T)、范式、维度差异",
      "input": ["多个方案配置"],
      "output": ["对比报告"]
    },
    {
      "id": "sensitivity",
      "name": "灵敏度分析",
      "description": "计算各维度改动对W(T)的影响，找出最值得改的维度",
      "input": ["当前配置", "目标"],
      "output": ["灵敏度排序", "调整建议"]
    },
    {
      "id": "quick_diagnose",
      "name": "轻量级快速诊断",
      "description": "只输出W(T)+范式定位+主辅比+一句话结论，速度快一倍，适合快速筛选和初步判断",
      "input": ["自然语言描述", "图片", "维度值"],
      "output": ["快速诊断结果"]
    }
  ],
  "supported_categories": [
    "phone", "car", "brand", "ui", "building"
  ],
