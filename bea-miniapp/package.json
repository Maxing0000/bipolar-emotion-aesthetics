{
  "name": "bea-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "BEA 双极情绪美学 - 跨端小程序（微信/抖音/H5）",
  "templateInfo": {
    "name": "default",
    "typescript": false,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "星空本空",
  "license": "CC BY 4.0",
  "dependencies": {
    "@tarojs/components": "3.6.20",
    "@tarojs/helper": "3.6.20",
    "@tarojs/plugin-framework-react": "3.6.20",
    "@tarojs/plugin-platform-h5": "3.6.20",
    "@tarojs/plugin-platform-weapp": "3.6.20",
    "@tarojs/plugin-platform-tt": "3.6.20",
    "@tarojs/react": "3.6.20",
    "@tarojs/runtime": "3.6.20",
    "@tarojs/shared": "3.6.20",
    "@tarojs/taro": "3.6.20",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@tarojs/cli": "3.6.20",
    "@tarojs/webpack5-runner": "3.6.20",
    "@types/react": "^18.2.0",
    "babel-preset-taro": "3.6.20",
    "sass": "^1.69.0",
    "webpack": "5.78.0"
  }
}
