#!/usr/bin/env bash
# ==============================================================================
# BEA 命令行工具 - 全局快捷入口
# ==============================================================================
# 安装后可全局调用:
#   bea calc --category phone --t "形状=4,质感=3"
#   bea analyze --interactive
#   bea quant --category car --t "形体=3,特征线=5"
#   bea docs          # 打开文档目录
#   bea examples      # 打开示例目录
#   bea version       # 显示版本
# ==============================================================================
set -euo pipefail

SKILL_NAME="bipolar-emotion-aesthetics"
VERSION="2.0.0"

# 自动检测技能安装路径
find_skill_dir() {
    local candidates=(
        "$HOME/Library/Application Support/Doubao/Default/.doubao/agent_mode/workspace/.user_skills/$SKILL_NAME"
        "$HOME/.doubao/agent_mode/workspace/.user_skills/$SKILL_NAME"
        "$HOME/.claude/skills/$SKILL_NAME"
        "$HOME/.skills/$SKILL_NAME"
    )

    for dir in "${candidates[@]}"; do
        if [[ -d "$dir" ]]; then
            echo "$dir"
            return 0
        fi
    done

    # 尝试从脚本位置推断
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -f "$script_dir/SKILL.md" ]]; then
        echo "$script_dir"
        return 0
    fi

    return 1
}

SKILL_DIR=$(find_skill_dir) || {
    echo "❌ 未找到 BEA 技能包安装目录"
    echo "请先运行 install.sh 安装技能包"
    exit 1
}

# 解析命令
case "${1:-help}" in
    calc|wt)
        shift
        python3 "$SKILL_DIR/scripts/wt_calc.py" "$@"
        ;;
    quant|analyze-full)
        shift
        python3 "$SKILL_DIR/scripts/bea_quant.py" "$@"
        ;;
    analyze|image)
        shift
        python3 "$SKILL_DIR/scripts/analyze_image.py" "$@"
        ;;
    docs|doc)
        echo "📚 BEA 文档目录: $SKILL_DIR/references/"
        echo ""
        ls -1 "$SKILL_DIR/references/" | sed 's/^/  /'
        ;;
    examples|example)
        echo "📖 BEA 示例目录: $SKILL_DIR/examples/"
        echo ""
        ls -1 "$SKILL_DIR/examples/" | sed 's/^/  /'
        ;;
    templates|template)
        echo "📋 BEA 模板目录: $SKILL_DIR/templates/"
        echo ""
        ls -1 "$SKILL_DIR/templates/" | sed 's/^/  /'
        ;;
    version|--version|-v)
        echo "BEA 双极情绪美学 v$VERSION"
        echo "安装路径: $SKILL_DIR"
        ;;
    help|--help|-h)
        echo "BEA 双极情绪美学命令行工具 v$VERSION"
        echo ""
        echo "用法: bea <命令> [选项]"
        echo ""
        echo "命令:"
        echo "  calc, wt          计算 W(T) 危极权重"
        echo "  quant             完整量化分析（范式+评分+诊断+处方）"
        echo "  analyze           图片分析（交互模式）"
        echo "  docs              显示文档列表"
        echo "  examples          显示示例列表"
        echo "  templates         显示模板列表"
        echo "  version           显示版本信息"
        echo "  help              显示此帮助"
        echo ""
        echo "示例:"
        echo "  bea calc --category phone --t \"形状=4,质感=3,色彩=2\""
        echo "  bea quant --category car --t \"形体=3,特征线=5,灯组=6\""
        echo "  bea analyze --interactive"
        ;;
    *)
        echo "❌ 未知命令: $1"
        echo "运行 'bea help' 查看可用命令"
        exit 1
        ;;
esac
